{
  "name": "wildguard-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --android --go",
    "ios": "expo start --ios --go",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "export:native": "expo export --platform android --platform ios",
    "doctor": "npx expo-doctor",
    "check:dependencies": "expo install --check"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
