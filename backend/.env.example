# Copy to backend/.env and fill in real values. Never commit backend/.env.

PORT=5000

# Browser origins allowed to call the API (comma-separated).
# Add the deployed frontend URL in production, e.g.
# CLIENT_URL=http://localhost:5173,https://wildguard.example.com
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>
# Use a personal database while developing (e.g. wildguard_kirulu) so that
# `npm run seed` does not reset your teammates' data. The integrated demo uses "wildguard".
MONGODB_DB_NAME=wildguard

# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Password given to every seeded demo account.
DEMO_PASSWORD=WildGuard@2026

# UC01 SMS fallback. There is no real SMS provider in the prototype:
#   simulated   = messages are logged and recorded as "simulated", never as delivered
#   unavailable = every SMS fails (demonstrates exception flows E2/E3)
SMS_GATEWAY_MODE=simulated

# true = Express also serves ../frontend/dist (single-origin deployment).
SERVE_FRONTEND=false
