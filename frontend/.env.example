# Copy to frontend/.env (never commit .env).

# Where the browser sends API requests.
# Local development: /api goes through the Vite proxy to the backend.
VITE_API_URL=/api
# Production: point at the deployed backend, e.g.
# VITE_API_URL=https://wildguard-api.example.com/api

# Backend address used by the Vite dev-server proxy (development only).
VITE_DEV_PROXY_TARGET=http://localhost:5000
